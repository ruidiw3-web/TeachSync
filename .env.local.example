# ---- Supabase ----
# 位置：supabase.com → 项目 → Settings → Data API
# 新版控制台里 anon key 叫 Publishable key（sb_publishable_ 前缀）
# service_role 叫 Secret key（sb_secret_ 前缀）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ---- 仅服务端使用，绝不暴露给浏览器 ----
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
